# Copy to .env.local for local development (Next.js loads .env.local
# automatically and it's git-ignored by default).

# --- Contact form (app/api/contact) ---
# Sends the enquiry notification to TO_EMAIL, then a best-effort "thanks,
# we've got it" confirmation back to the submitter's own email address.
# Production is currently configured with Gmail SMTP + an App Password for
# anshworks4u@gmail.com (myaccount.google.com/apppasswords — requires
# 2-Step Verification on that account).
#
# TO_EMAIL is anshworks4u@gmail.com, not info@edgeweb.co — the edgeweb.co
# domain has no MX records, so nothing can actually receive mail at
# info@edgeweb.co yet. Point TO_EMAIL there once you set up real mail
# hosting for the domain (Google Workspace, Zoho Mail, or a forwarding-only
# service like Cloudflare Email Routing) and add the MX records it gives you.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TO_EMAIL=anshworks4u@gmail.com

# --- /admin CMS screen ---
# Prefer ADMIN_PASSWORD_HASH (bcrypt hash) in production; ADMIN_PASSWORD is a
# plaintext fallback for local dev only.
ADMIN_PASSWORD=edgewebadmin
ADMIN_PASSWORD_HASH=

# Note: /admin edits write to a local data/site-config.json file, which
# doesn't persist on a serverless function's read-only filesystem in
# production (same limitation the original CMS had). Fine for local dev.
